# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel

# Environment variables - NEVER commit these!
# Contains sensitive credentials (database passwords, API keys, JWT secrets)
.env
.env.*
server/.env
server/.env.*

# Only placeholder templates are committed. A file is allowed back in here
# solely because every value in it is a placeholder - if a real credential
# ever lands in one, it stops being a template and the exception is wrong.
!.env.example
!.env.*.example
!.env.example.*
!server/.env.example
!server/.env.*.example
!server/.env.example.*
