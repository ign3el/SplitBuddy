# SplitBuddy - environment template
#
# Copy to .env and fill in real values:   cp .env.example .env
# docker-compose.yml reads `.env` for all three services (see env_file:).
#
# .env and every .env.* variant are gitignored. Only *.example files are
# committed. Never put a real credential in this file.
#
# Key names below mirror the running app exactly - note it uses EMAIL_* for
# mail and DB_SSL_REQUIRED (not SMTP_* / DB_SSL).

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
PORT=3003

# ---------------------------------------------------------------------------
# Database (MySQL)
# ---------------------------------------------------------------------------
DB_HOST=db
DB_PORT=3306
DB_USER=splitbuddy
DB_PASSWORD=your-db-password-here
DB_NAME=splitbuddy
# Only needed when docker-compose provisions the MySQL container itself
DB_ROOT_PASSWORD=your-db-root-password-here
# true for remote/managed MySQL (e.g. Aiven), false for a local/compose DB
DB_SSL_REQUIRED=false

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate a fresh one per environment:  openssl rand -base64 48
JWT_SECRET=your-jwt-secret-here

# ---------------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------------
API_PUBLIC_URL=https://splitbuddy.ign3el.com/api
FRONTEND_URL=https://splitbuddy.ign3el.com
CORS_ORIGIN=https://splitbuddy.ign3el.com
RESET_PUBLIC_URL=https://splitbuddy.ign3el.com/reset-password
VERIFY_PUBLIC_URL=https://splitbuddy.ign3el.com/verify-email

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
# Gmail App Password (16 chars, shown in 4 space-separated groups).
# Google Account -> Security -> App passwords. Never the account password.
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM="SplitBuddy <info@example.com>"

# ---------------------------------------------------------------------------
# Frontend build-time vars (Vite) - only needed where the frontend is built
# The Supabase publishable/anon key is public by design.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=https://splitbuddy.ign3el.com/api
VITE_SUPABASE_URL=https://mwnyowrnpyaznslgbczq.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_uyLgQ-opZhzhmIHflBkQnA_V4Dn5fuE
