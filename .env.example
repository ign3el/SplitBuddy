# SplitBuddy - environment template
#
# Copy to .env and fill in real values:   cp .env.example .env
# docker-compose.yml reads `.env` for all three services (see env_file:).
#
# .env and every .env.* variant are gitignored. Only *.example files are
# committed. Never put a real credential in this file.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3003

# ---------------------------------------------------------------------------
# Database (MySQL)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=splitbuddy
DB_PASSWORD=your-db-password-here
DB_NAME=splitbuddy
# true when the DB is remote/managed (e.g. Aiven), false for localhost
DB_SSL=false

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate a fresh one per environment:  openssl rand -base64 48
JWT_SECRET=your-jwt-secret-here

# ---------------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3003
CORS_ORIGIN=http://localhost:5173
RESET_PUBLIC_URL=http://localhost:5173/reset-password
VERIFY_PUBLIC_URL=http://localhost:5173/verify-email

# ---------------------------------------------------------------------------
# Email (SMTP)
# ---------------------------------------------------------------------------
# For Gmail this must be an App Password, not the account password.
# Revoke it at: Google Account -> Security -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
# true = log emails to console instead of sending (local development)
MOCK_EMAIL=true

# ---------------------------------------------------------------------------
# Supabase (client-side; the publishable/anon key is public by design)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://mwnyowrnpyaznslgbczq.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_uyLgQ-opZhzhmIHflBkQnA_V4Dn5fuE
